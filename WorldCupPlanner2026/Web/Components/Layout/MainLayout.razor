@inherits LayoutComponentBase
@using IServices
@inject ISessionService SessionService
@inject NavigationManager Navigation

<div class="page">

    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-content">

        <div class="top-row px-4">
            @if (SessionService.IsLoggedIn())
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted">Hola, <strong>@SessionService.GetCurrentUser()?.Name</strong></span>
                    <a href="/profile" class="btn btn-outline-secondary btn-sm">Mi cuenta</a>
                    <button class="btn btn-danger btn-sm" @onclick="HandleLogout">Cerrar sesión</button>
                </div>
            }
            else
            {
                <a href="/login" class="btn btn-outline-secondary btn-sm">Iniciar sesión</a>
            }
        </div>

        <article class="content-wrapper px-4 py-4">
            <div class="container-fluid">
                @Body
            </div>
        </article>

    </main>

</div>

@code {
    private void HandleLogout()
    {
        SessionService.Logout();
        Navigation.NavigateTo("/login");
    }
}
