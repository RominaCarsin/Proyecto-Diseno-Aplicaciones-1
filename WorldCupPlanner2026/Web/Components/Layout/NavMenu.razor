@using Microsoft.AspNetCore.Components.Routing

<div class="sidebar-container">

    @* HEADER *@
    <div class="sidebar-header">
        <div class="position-relative">

            <div class="brand-stripe">

                <div class="brand-stripe-segment bg-wc-blue"></div>
                <div class="brand-stripe-segment bg-wc-red"></div>
                <div class="brand-stripe-segment bg-wc-green"></div>

            </div>

            <h1 class="h5 mb-0 pt-4 fw-bold text-wc-text">
                WorldCupPlanner 2026
            </h1>

        </div>
    </div>

    @* NAVIGATION *@
    <nav class="sidebar-nav" aria-label="Main navigation">

        @foreach (var item in navItems)
        {
            <NavLink class="nav-item-custom"
                     href="@item.Href"
                     style="@($"--item-color: {item.Color};")"
                     Match="NavLinkMatch.All">

                <span class="active-indicator"></span>

                <i class="@item.Icon nav-item-icon" aria-hidden="true"></i>

                <span>@item.Label</span>

            </NavLink>
        }

    </nav>

    @* FOOTER *@
    <div class="sidebar-footer">

        <div class="text-sm">
            <p class="mb-0 fw-bold">FIFA World Cup 2026</p>
            <p class="small mb-0 text-muted">Management System</p>
        </div>

    </div>

</div>

@code {

    private List<NavigationModel> navItems = new()
    {
        new("home", "Inicio", "bi bi-house-door", "#1b2789", "/"),
        new("teams", "Equipos", "bi bi-people", "#dc0201", "/teams"),
        new("stadiums", "Estadios", "bi bi-geo-alt", "#04cf5c", "/stadiums"),
        new("matches", "Partidos", "bi bi-calendar3", "#dc0201", "/matches"),
        new("groups", "Grupos", "bi bi-grid-3x3-gap", "#1b2789", "/groups"),
        new("knockout", "Segunda Fase", "bi bi-trophy", "#04cf5c", "/knockout"),
        new("user", "Usuario", "bi bi-person", "#1b2789", "/profile"),
        new("import", "Importar", "bi bi-cloud-upload", "#dc0201", "/import"),
        new("logs", "Logs", "bi bi-file-earmark-text", "#04cf5c", "/logs")
    };

    public record NavigationModel(
        string Id,
        string Label,
        string Icon,
        string Color,
        string Href
    );
}
