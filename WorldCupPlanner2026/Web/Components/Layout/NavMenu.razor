@using IServices
@using DTOs
@inject ISessionService SessionService
@inject IAuthStateService AuthStateService
@implements IDisposable

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (SessionService.IsLoggedIn() &&
             (SessionService.CurrentUserHasRole(RoleDto.Admin) || SessionService.CurrentUserHasRole(RoleDto.Editor)))
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="Teams/Create">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Team Management
                </NavLink>
                <NavLink class="nav-link" href="stadiums/create">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Stadium Management
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthStateService.OnChange += OnAuthStateChanged;
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthStateService.OnChange -= OnAuthStateChanged;
    }
}