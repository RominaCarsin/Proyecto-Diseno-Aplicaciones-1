@* Shared/ImageWithFallback.razor *@

@if (didError)
{
    <div class="inline-block bg-light text-center align-middle @Class" style="@Style">
        <div class="d-flex align-items-center justify-content-center w-100 h-100">
            <img src="@ErrorImgSrc" alt="Error loading image" class="opacity-25" />
        </div>
    </div>
}
else
{
    <img src="@Src" alt="@Alt" class="@Class" style="@Style" @onerror="HandleError" />
}

@code {
    [Parameter] public string Src { get; set; } = "";
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    private bool didError = false;

    private const string ErrorImgSrc = "data:image/svg+xml;base64,";

    private void HandleError()
    {
        didError = true;
    }
}