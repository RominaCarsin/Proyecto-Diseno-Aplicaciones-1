@page "/Stadiums/Create"
@rendermode InteractiveServer
@using Domain
@using IServices
@inject IStadiumService StadiumService

<style>
  .page-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .ph {
    margin-bottom: 1.5rem;
  }

  .pt {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
  }

  .ps {
    color: #666;
    font-size: 1rem;
  }

  .card {
    background: white;
    border: 1px solid #ddd;
    border-radius: 8px;
    overflow: hidden;
  }

  .card-header {
    padding: 1rem 1.25rem;
    background: #f7f7f7;
    border-bottom: 1px solid #ddd;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 600;
  }

  .card-body {
    padding: 1.25rem;
  }

  .fg {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .fl {
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .req {
    color: #c0392b;
  }

  .finput {
    width: 100%;
    max-width: 420px;
    padding: 0.55rem 0.7rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
  }

  textarea.finput {
    min-height: 90px;
    resize: vertical;
  }

  .finput.invalid {
    border-color: #c0392b;
  }

  .ferr {
    color: #c0392b;
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .fhint {
    color: #777;
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .alert-box {
    padding: 0.75rem;
    border-radius: 6px;
    margin-top: 1rem;
  }

  .alert-box.suc {
    background: #eafaf1;
    color: #1e8449;
  }

  .alert-box.err {
    background: #fdecea;
    color: #c0392b;
  }

  .card-footer {
    padding: 1rem 1.25rem;
    background: #f7f7f7;
    border-top: 1px solid #ddd;
    display: flex;
    gap: 0.75rem;
  }

  .btn,
  .btn-p {
    border: none;
    border-radius: 6px;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .btn-p {
    background: #1f2937;
    color: white;
  }

  .btn-g {
    background: #e5e7eb;
    color: #111827;
  }

  .btn-s {
    background: #dbeafe;
    color: #1d4ed8;
  }

  .btn-d {
    background: #fee2e2;
    color: #b91c1c;
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    text-align: left;
    padding: 0.75rem;
    border-bottom: 1px solid #ddd;
  }

  td {
    padding: 0.75rem;
    border-bottom: 1px solid #eee;
  }
</style>

<div class="page-wrap">

  <div class="ph">
    <h1 class="pt">Stadiums</h1>
    <p class="ps">Create new stadium · WorldCupPlanner 2026</p>
  </div>

  <div class="card">
    <div class="card-header">
      <span class="card-title">@(_editingStadiumName != null ? "Edit stadium" : "New stadium")</span>
    </div>

    <div class="card-body">

      <div class="fg">
        <label class="fl">Name <span class="req">*</span></label>
        <input class="finput @(_nameInvalid ? "invalid" : "")"
               type="text"
               maxlength="80"
               placeholder="Ex: Estadio Centenario"
               @bind="_name"
               @bind:event="oninput" />
        @if (_nameInvalid)
        {
          <span class="ferr">Name is required (1–80 characters)</span>
        }
      </div>

      <div class="fg">
        <label class="fl">City <span class="req">*</span></label>
        <input class="finput @(_cityInvalid ? "invalid" : "")"
               type="text"
               maxlength="60"
               placeholder="Ex: Montevideo"
               @bind="_city"
               @bind:event="oninput" />
        @if (_cityInvalid)
        {
          <span class="ferr">City is required (1–60 characters)</span>
        }
      </div>

      <div class="fg">
        <label class="fl">Description</label>
        <textarea class="finput @(_descInvalid ? "invalid" : "")"
                  maxlength="400"
                  placeholder="Optional description..."
                  @bind="_description"
                  @bind:event="oninput"></textarea>
        @if (_descInvalid)
        {
          <span class="ferr">Description cannot exceed 400 characters</span>
        }
      </div>

      <div class="fg">
        <label class="fl">Capacity <span class="req">*</span></label>
        <input class="finput @(_capacityInvalid ? "invalid" : "")"
               type="number"
               min="20000"
               placeholder="Ex: 60000"
               @bind="_capacity"
               @bind:event="oninput" />
        <span class="fhint">Minimum 20,000 spectators</span>
        @if (_capacityInvalid)
        {
          <span class="ferr">Capacity must be at least 20,000</span>
        }
      </div>

      @if (!string.IsNullOrEmpty(_successMessage))
      {
        <div class="alert-box suc">✓ @_successMessage</div>
      }

      @if (!string.IsNullOrEmpty(_errorMessage))
      {
        <div class="alert-box err">@_errorMessage</div>
      }

    </div>

    <div class="card-footer">
      @if (_editingStadiumName != null)
      {
        <button class="btn btn-g" @onclick="CancelEdit">Cancel edit</button>
      }

      <button class="btn-p" @onclick="@(_editingStadiumName != null ? SaveEdit : Save)">
        @(_editingStadiumName != null ? "Update stadium" : "Save stadium")
      </button>
    </div>
  </div>

  <div class="card" style="margin-top: 1.5rem;">
    <div class="card-header">
      <span class="card-title">Registered stadiums (@_stadiums.Count())</span>
    </div>

    <div class="card-body">
      @if (!_stadiums.Any())
      {
        <p style="color: #888;">No stadiums registered yet.</p>
      }
      else
      {
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>City</th>
              <th>Capacity</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            @foreach (var stadium in _stadiums)
            {
              <tr>
                <td>@stadium.Name</td>
                <td>@stadium.City</td>
                <td>@stadium.Capacity.ToString("N0")</td>
                <td>@(stadium.Description ?? "-")</td>
                <td>
                  <button class="btn btn-s"
                          disabled="@(_editingStadiumName == stadium.Name)"
                          @onclick="() => EditStadium(stadium)">
                    Edit
                  </button>

                  <button class="btn btn-d"
                          disabled="@(_editingStadiumName == stadium.Name)"
                          @onclick="() => DeleteStadium(stadium.Name)">
                    Delete
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>

</div>

@code {
    private string _name = string.Empty;
    private string _city = string.Empty;
    private string? _description;
    private int _capacity;

    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    private string? _editingStadiumName = null;

    private bool _nameInvalid;
    private bool _cityInvalid;
    private bool _descInvalid;
    private bool _capacityInvalid;

    private IEnumerable<Stadium> _stadiums = Enumerable.Empty<Stadium>();

    protected override void OnInitialized()
    {
        LoadStadiums();
    }

    private void LoadStadiums()
    {
        _stadiums = StadiumService.GetStadiums();
    }

    private void ClearForm()
    {
        _name = string.Empty;
        _city = string.Empty;
        _description = null;
        _capacity = 0;

        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        _editingStadiumName = null;

        _nameInvalid = false;
        _cityInvalid = false;
        _descInvalid = false;
        _capacityInvalid = false;
    }

    private void EditStadium(Stadium stadium)
    {
        _editingStadiumName = stadium.Name;

        _name = stadium.Name;
        _city = stadium.City;
        _description = stadium.Description;
        _capacity = stadium.Capacity;

        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        _nameInvalid = false;
        _cityInvalid = false;
        _descInvalid = false;
        _capacityInvalid = false;
    }

    private void CancelEdit()
    {
        ClearForm();
    }

    private bool ValidateForm()
    {
        _nameInvalid = string.IsNullOrWhiteSpace(_name) || _name.Length > 80;
        _cityInvalid = string.IsNullOrWhiteSpace(_city) || _city.Length > 60;
        _descInvalid = _description != null && _description.Length > 400;
        _capacityInvalid = _capacity < 20000;

        return !_nameInvalid && !_cityInvalid && !_descInvalid && !_capacityInvalid;
    }

    private void Save()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (!ValidateForm()) return;

        try
        {
            var stadium = new Stadium(_name, _city, _description, _capacity);
            StadiumService.AddStadium(stadium);

            _successMessage = $"Stadium '{_name}' created successfully!";
            ClearForm();
            LoadStadiums();
        }
        catch (ArgumentException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SaveEdit()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (!ValidateForm()) return;

        try
        {
            var stadium = new Stadium(_name, _city, _description, _capacity);
            StadiumService.UpdateStadium(_editingStadiumName!, stadium);

            _successMessage = $"Stadium '{_name}' updated successfully!";
            ClearForm();
            LoadStadiums();
        }
        catch (ArgumentException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void DeleteStadium(string stadiumName)
    {
        try
        {
            if (_editingStadiumName == stadiumName)
            {
                ClearForm();
            }

            StadiumService.DeleteStadium(stadiumName);

            _successMessage = $"Stadium '{stadiumName}' deleted successfully!";
            LoadStadiums();
        }
        catch (ArgumentException ex)
        {
            _errorMessage = ex.Message;
        }
    }
}