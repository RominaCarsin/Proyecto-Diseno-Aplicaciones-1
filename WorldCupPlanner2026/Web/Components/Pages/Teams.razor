@using Web.Components.Shared
@page "/teams"
@using System.Collections.Generic

<div class="container-fluid p-0 space-y-6">
    
    <!-- FORMULARIO DE CREACIÓN / EDICIÓN -->
    <div class="bg-white border-custom p-4 diagonal-corners">
        <h3 class="mb-3">@(editingTeam == null ? "Crear Equipo" : "Editar Equipo")</h3>
        <GeometricDivider />

        <div class="row g-3 mb-4 mt-2">
            <div class="col-md-4">
                <label class="form-label fw-bold">Nombre</label>
                <input type="text" @bind="formData.Name" placeholder="Nombre del equipo"
                       class="form-control border-custom-input" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Confederación</label>
                <select @bind="formData.Confederation" class="form-select border-custom-input">
                    @foreach (var conf in confederations)
                    {
                        <option value="@conf">@conf</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Ranking FIFA</label>
                <input type="number" @bind="formData.Ranking" min="1"
                       class="form-control border-custom-input" />
            </div>
        </div>

        <div class="d-flex gap-2">
            @if (editingTeam != null)
            {
                <button @onclick="UpdateTeam" class="btn btn-wc-blue px-4">Actualizar</button>
                <button @onclick="CancelEdit" class="btn btn-outline-dark border-custom px-4">Cancelar</button>
            }
            else
            {
                <button @onclick="CreateTeam" class="btn btn-wc-red px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i> Crear
                </button>
            }
        </div>
    </div>

    <!-- SECCIÓN DE SIMULACIÓN -->
    <div class="bg-white border-custom p-4 diagonal-corners">
        <h3 class="mb-3">Simular / Completar Equipos</h3>
        <GeometricDivider />

        <div class="row align-items-end g-3 mt-2">
            <div class="col-md-6">
                <label class="form-label fw-bold">Semilla (opcional)</label>
                <input type="text" @bind="simulationSeed" placeholder="Semilla para simulación"
                       class="form-control border-custom-input" />
            </div>
            <div class="col-md-4">
                <button @onclick="SimulateTeams" disabled="@(teams.Count >= 48)"
                        class="btn btn-wc-green w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-shuffle"></i> Autocompletar hasta 48
                </button>
            </div>
            <div class="col-md-2">
                <div class="status-counter text-center p-2 border-custom bg-light fw-bold">
                    @teams.Count / 48
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE EQUIPOS -->
    <div class="bg-white border-custom diagonal-corners overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light border-bottom-2">
                    <tr>
                        <th class="px-4 py-3">Nombre</th>
                        <th class="px-4 py-3">Confederación</th>
                        <th class="px-4 py-3">Ranking</th>
                        <th class="px-4 py-3">Estado</th>
                        <th class="px-4 py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var team in teams)
                    {
                        <tr>
                            <td class="px-4 py-3 align-middle fw-medium">@team.Name</td>
                            <td class="px-4 py-3 align-middle">
                                <span class="badge-conf @GetConfColor(team.Confederation)">
                                    @team.Confederation
                                </span>
                            </td>
                            <td class="px-4 py-3 align-middle">@team.Ranking</td>
                            <td class="px-4 py-3 align-middle">
                                <span class="badge @(team.IsActive ? "bg-success-light" : "bg-secondary-light")">
                                    @(team.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="px-4 py-3 align-middle">
                                <div class="d-flex justify-content-center gap-2">
                                    <button @onclick="() => EditTeam(team)" class="btn btn-sm btn-light border-custom">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button @onclick="() => DeleteTeam(team.Id)" class="btn btn-sm btn-outline-danger border-custom">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<TeamModel> teams = new()
    {
        new() { Id = Guid.NewGuid(), Name = "Brasil", Confederation = "CONMEBOL", Ranking = 1, IsActive = true },
        new() { Id = Guid.NewGuid(), Name = "Argentina", Confederation = "CONMEBOL", Ranking = 2, IsActive = true },
        new() { Id = Guid.NewGuid(), Name = "Francia", Confederation = "UEFA", Ranking = 3, IsActive = true }
    };

    private TeamModel formData = new() { Confederation = "AFC", Ranking = 1 };
    private TeamModel? editingTeam = null;
    private string simulationSeed = "";
    private readonly string[] confederations = { "AFC", "CAF", "CONCACAF", "CONMEBOL", "OFC", "UEFA" };

    private void CreateTeam()
    {
        if (string.IsNullOrWhiteSpace(formData.Name)) return;
        
        teams.Add(new TeamModel 
        { 
            Id = Guid.NewGuid(), 
            Name = formData.Name, 
            Confederation = formData.Confederation, 
            Ranking = formData.Ranking,
            IsActive = true 
        });

        formData = new TeamModel { Confederation = "AFC", Ranking = 1 };
    }

    private void EditTeam(TeamModel team)
    {
        editingTeam = team;
        formData = new TeamModel 
        { 
            Name = team.Name, 
            Confederation = team.Confederation, 
            Ranking = team.Ranking 
        };
    }

    private void UpdateTeam()
    {
        if (editingTeam == null || string.IsNullOrWhiteSpace(formData.Name)) return;

        editingTeam.Name = formData.Name;
        editingTeam.Confederation = formData.Confederation;
        editingTeam.Ranking = formData.Ranking;

        CancelEdit();
    }

    private void CancelEdit()
    {
        editingTeam = null;
        formData = new TeamModel { Confederation = "AFC", Ranking = 1 };
    }

    private void DeleteTeam(Guid id)
    {
        teams.RemoveAll(t => t.Id == id);
    }

    private void SimulateTeams()
    {
        int currentCount = teams.Count;
        if (currentCount >= 48) return;

        var mockNames = new[] { "España", "Alemania", "Italia", "Portugal", "Uruguay", "Colombia", "Ecuador", "Chile" };
        var random = new Random();

        foreach (var name in mockNames.Take(48 - currentCount))
        {
            teams.Add(new TeamModel
            {
                Id = Guid.NewGuid(),
                Name = name,
                Confederation = confederations[random.Next(confederations.Length)],
                Ranking = teams.Count + 1,
                IsActive = true
            });
        }
    }

    private string GetConfColor(string conf) => conf switch
    {
        "AFC" => "conf-afc",
        "CAF" => "conf-caf",
        "CONCACAF" => "conf-concacaf",
        "CONMEBOL" => "conf-conmebol",
        "OFC" => "conf-ofc",
        "UEFA" => "conf-uefa",
        _ => "bg-light"
    };

    public class TeamModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Confederation { get; set; } = "";
        public int Ranking { get; set; }
        public bool IsActive { get; set; }
    }
}