@using Web.Components.Shared
@using DTOs
@using IServices
@page "/knockout"
@inject ISessionService SessionService
@inject IMatchService MatchService

<div class="container-fluid p-0 space-y-6">
    <div class="bg-white border-custom p-4 diagonal-corners">
        <h3 class="mb-3">Segunda fase</h3>
        <GeometricDivider />

        <div class="alert alert-warning border-custom mt-3">
            FALTA: no existe un servicio/contrato de dominio para generar los cruces de segunda fase,
            persistir las llaves A1..B8/C1..Final, ni avanzar el bracket con ganadores y perdedores.
        </div>

        @if (!IsEditor)
        {
            <div class="text-muted">Solo un Editor puede realizar sorteos de cruces.</div>
        }
    </div>

    <div class="bg-white border-custom diagonal-corners overflow-hidden">
        <div class="bg-light px-4 py-3">
            <h4 class="mb-0">Partidos eliminatorios existentes</h4>
        </div>
        <GeometricDivider />

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="px-4 py-3">Fase</th>
                        <th class="px-4 py-3">Fecha</th>
                        <th class="px-4 py-3">Local</th>
                        <th class="px-4 py-3">Resultado</th>
                        <th class="px-4 py-3">Visitante</th>
                        <th class="px-4 py-3">Ganador</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!KnockoutMatches.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-4 py-4 text-center text-muted">
                                No hay partidos eliminatorios generados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var match in KnockoutMatches)
                        {
                            <tr>
                                <td class="px-4 py-3">@match.Phase</td>
                                <td class="px-4 py-3">@match.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="px-4 py-3 fw-bold">@match.HomeTeam.Name</td>
                                <td class="px-4 py-3">@FormatResult(match)</td>
                                <td class="px-4 py-3 fw-bold">@match.AwayTeam.Name</td>
                                <td class="px-4 py-3">@(match.Winner?.Name ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private bool IsEditor => SessionService.IsLoggedIn() && SessionService.CurrentUserHasRole(RoleDto.Editor);

    private IEnumerable<MatchResponse> KnockoutMatches => MatchService.GetMatches()
        .Where(match => match.Phase != "GroupStage")
        .OrderBy(match => match.Date);

    private static string FormatResult(MatchResponse match)
    {
        return match.HomeGoals.HasValue && match.AwayGoals.HasValue
            ? $"{match.HomeGoals} - {match.AwayGoals}"
            : "-";
    }
}
