@using DTOs
@using IServices
@using Domain
@page "/notifications"
@inject ISessionService SessionService
@inject INotificationService NotificationService
@implements IDisposable

<div class="container-fluid p-0 space-y-6">

    @if (!IsJournalist)
    {
        <div class="bg-white border-custom p-4 diagonal-corners text-muted">
            No tienes permisos para ver las notificaciones.
        </div>
    }
    else
    {
        <div class="bg-white border-custom p-6 diagonal-corners">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h3 class="mb-0">
                    <i class="bi bi-bell me-2"></i>Notificaciones
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger ms-2">@unreadCount</span>
                    }
                </h3>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary border-custom btn-sm" @onclick="ShowUnread">
                        <i class="bi bi-envelope me-1"></i> Sin leer
                    </button>
                    <button class="btn btn-outline-secondary border-custom btn-sm" @onclick="ShowAll">
                        <i class="bi bi-archive me-1"></i> Todas
                    </button>
                    @if (unreadCount > 0)
                    {
                        <button class="btn btn-outline-success border-custom btn-sm" @onclick="MarkAllAsRead">
                            <i class="bi bi-check2-all me-1"></i> Marcar todas como leídas
                        </button>
                    }
                </div>
            </div>

            <GeometricDivider />

            <div class="mt-4">
                @if (!notifications.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-bell-slash" style="font-size: 2rem;"></i>
                        <p class="mt-2 mb-0">No hay notificaciones.</p>
                    </div>
                }
                else
                {
                    @foreach (var notification in notifications)
                    {
                        <div class="notification-item @(notification.IsRead ? "notification-read" : "notification-unread") border-custom p-3 mb-3">
                            <div class="d-flex align-items-start justify-content-between">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="notification-icon mt-1">
                                        @if (notification.IsRead)
                                        {
                                            <i class="bi bi-envelope-open text-muted"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-envelope-fill text-primary"></i>
                                        }
                                    </div>
                                    <div>
                                        <p class="mb-1 @(notification.IsRead ? "text-muted" : "fw-bold")">@notification.Message</p>
                                        <small class="text-muted">
                                            <i class="bi bi-clock me-1"></i>
                                            @notification.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </div>
                                </div>
                                @if (!notification.IsRead)
                                {
                                    <button class="btn btn-sm btn-success"
                                            @onclick="() => MarkAsRead(notification.Id)"
                                            title="Marcar como leída">
                                        <i class="bi bi-check2 me-1"></i>Leída
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private List<NotificationResponse> notifications = new();
    private bool showUnreadOnly = true;
    private int unreadCount = 0;

    private bool IsJournalist => SessionService.IsLoggedIn() && SessionService.CurrentUserHasRole(RoleDto.Journalist);

    private int CurrentUserId => SessionService.GetCurrentUser()?.Id ?? 0;

    protected override void OnInitialized()
    {
        if (!IsJournalist) return;
        LoadNotifications();
    }

    private void LoadNotifications()
    {
        if (CurrentUserId == 0) return;

        unreadCount = NotificationService.GetUnreadCount(CurrentUserId);

        notifications = showUnreadOnly
            ? NotificationService.GetUnreadNotifications(CurrentUserId).ToList()
            : NotificationService.GetAllNotifications(CurrentUserId).ToList();
    }

    private void ShowUnread()
    {
        showUnreadOnly = true;
        LoadNotifications();
    }

    private void ShowAll()
    {
        showUnreadOnly = false;
        LoadNotifications();
    }

    private void MarkAsRead(int notificationId)
    {
        NotificationService.MarkAsRead(notificationId);
        LoadNotifications();
    }

    private void MarkAllAsRead()
    {
        NotificationService.MarkAllAsRead(CurrentUserId);
        LoadNotifications();
    }

    public void Dispose() { }
}

<style>
    .notification-unread {
        background-color: rgba(13, 110, 253, 0.05);
        border-left: 3px solid #0d6efd !important;
    }

    .notification-read {
        background-color: transparent;
        border-left: 3px solid transparent !important;
    }

    .notification-item {
        transition: background-color 0.2s ease;
    }

    .notification-item:hover {
        background-color: rgba(0, 0, 0, 0.02);
    }
</style>
