@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar tu solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID de Solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de Desarrollo</h3>
<p>
    Al cambiar al entorno de <strong>Desarrollo</strong> se mostrará información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El entorno de Desarrollo no debería estar habilitado en aplicaciones implementadas.</strong>
    Puede resultar en la visualización de información sensible de excepciones a los usuarios finales.
    Para depuración local, habilite el entorno de <strong>Desarrollo</strong> configurando la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> a <strong>Development</strong>
    y reinicie la aplicación.
</p>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

}