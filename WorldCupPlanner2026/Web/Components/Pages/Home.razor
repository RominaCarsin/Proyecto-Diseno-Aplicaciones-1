@page "/"
@rendermode InteractiveServer
@using IServices
@using Web.Components.Shared
@inject ISessionService SessionService
@inject ITeamService TeamService
@inject IStadiumService StadiumService
@inject ITournamentService TournamentService

<PageTitle>Inicio - WorldCupPlanner 2026</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h4 fw-bold mb-1">WorldCupPlanner 2026</h1>
            <p class="text-muted mb-0">Bienvenido, @SessionService.GetCurrentUser()?.Name!</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        @foreach (var stat in Stats)
        {
            <div class="col-md-3">
                <a href="@stat.Href" class="stat-card-link">
                    <div class="bg-white border-custom diagonal-corners overflow-hidden h-100 stat-card-clickable">
                        <div class="@stat.Color p-4 d-flex align-items-center justify-content-center">
                            <i class="bi @stat.Icon text-white fs-2"></i>
                        </div>

                        <GeometricDivider />

                        <div class="p-4">
                            <div class="text-3xl font-bold mb-1">@stat.Value</div>
                            <div class="text-muted small text-uppercase">@stat.Label</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="bg-white border-custom diagonal-corners h-100">
                <div class="bg-primary-custom text-white px-4 py-3">
                    <h5 class="mb-0">Proximos Partidos</h5>
                </div>

                <GeometricDivider />

                <div class="p-4">
                    @if (UpcomingMatches.Any())
                    {
                        @foreach (var match in UpcomingMatches)
                        {
                            <div class="border-custom p-3 mb-3 diagonal-corners-sm">
                                <div class="d-flex justify-content-between mb-3 small text-muted">
                                    <span class="badge bg-light text-dark px-3 py-2">@match.Date</span>
                                    <span>@match.Stadium</span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between fw-bold">
                                    <span class="flex-fill text-end pe-3">@match.HomeTeam</span>
                                    <span class="border-custom px-3 py-1">VS</span>
                                    <span class="flex-fill ps-3">@match.AwayTeam</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted">No hay partidos proximos cargados.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card-link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .stat-card-link:hover {
        color: inherit;
        text-decoration: none;
    }

    .stat-card-clickable {
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .stat-card-clickable:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12);
    }
</style>

@code {
    private List<StatCard> Stats = new();
    private List<MatchInfo> UpcomingMatches = new();

    protected override void OnInitialized()
    {
        LoadDashboard();
    }

    private void LoadDashboard()
    {
        var teams = TeamService.GetTeams().Count();
        var stadiums = StadiumService.GetAllStadiums().Count();
        var groups = TournamentService.GetGroups().Count();
        var matches = TournamentService.GetMatches().ToList();

        Stats =
        [
            new("Equipos", teams.ToString(), "bi-people-fill", "bg-wc-red", "/teams/create"),
            new("Estadios", stadiums.ToString(), "bi-geo-alt-fill", "bg-wc-green", "/stadiums"),
            new("Grupos", groups.ToString(), "bi-grid-3x3-gap-fill", "bg-wc-blue", "/groups"),
            new("Partidos", matches.Count.ToString(), "bi-calendar3", "bg-danger-custom", "/matches")
        ];

        UpcomingMatches = matches
            .Where(match => !match.HasResult)
            .OrderBy(match => match.Date)
            .Take(5)
            .Select(match => new MatchInfo(
                match.Date.ToString("dd/MM/yyyy HH:mm"),
                match.HomeTeam.Name,
                match.AwayTeam.Name,
                match.Stadium.Name))
            .ToList();
    }

    public record StatCard(
        string Label,
        string Value,
        string Icon,
        string Color,
        string Href
    );

    public record MatchInfo(
        string Date,
        string HomeTeam,
        string AwayTeam,
        string Stadium
    );
}