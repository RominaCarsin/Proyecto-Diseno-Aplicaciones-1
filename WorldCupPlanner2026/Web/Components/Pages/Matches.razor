@using Web.Components.Shared
@using DTOs
@using IServices
@page "/matches"
@inject ITournamentService TournamentService
@inject IStadiumService StadiumService
@inject ISessionService SessionService

<div class="container-fluid p-0 space-y-6">
    <div class="bg-white border-custom p-4 diagonal-corners">
        <h3 class="mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-funnel"></i> Filtros
        </h3>
        <GeometricDivider />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger border-custom py-2 mt-3">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success border-custom py-2 mt-3">@successMessage</div>
        }

        <div class="row g-3 mt-2">
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha</label>
                <input type="date" @bind="filterDate" @bind:event="oninput"
                       class="form-control border-custom-input" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Estadio</label>
                <select @bind="filterStadium" class="form-select border-custom-input">
                    <option value="">Todos</option>
                    @foreach (var stadium in availableStadiums)
                    {
                        <option value="@stadium">@stadium</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">Grupo</label>
                <select @bind="filterGroup" class="form-select border-custom-input">
                    <option value="">Todos</option>
                    @foreach (var group in availableGroups)
                    {
                        <option value="@group">Grupo @group</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold">Fase</label>
                <select @bind="filterPhase" class="form-select border-custom-input">
                    <option value="">Todas</option>
                    @foreach (var phase in availablePhases)
                    {
                        <option value="@phase">@phase</option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button @onclick="ClearFilters" class="btn btn-outline-dark border-custom w-100">
                    Limpiar
                </button>
            </div>
        </div>
    </div>

    @* <div class="bg-white border-custom p-4 diagonal-corners d-flex justify-content-between align-items-center"> *@
    @*     <span class="fw-bold">Finalizar todos los partidos con resultado cargado (recalcula el ranking)</span> *@
    @*     <button class="btn btn-wc-red px-4" disabled="@(!IsEditor)" @onclick="FinishAll"> *@
    @*         <i class="bi bi-flag-fill"></i> Finalizar todos *@
    @*     </button> *@
    @* </div> *@

    @if (!FilteredMatches.Any())
    {
        <div class="bg-white border-custom p-4 diagonal-corners text-muted">
            No hay partidos para mostrar.
        </div>
    }
    else
    {
        @foreach (var dateGroup in FilteredMatches.GroupBy(match => match.Date.Date).OrderBy(group => group.Key))
        {
            <div class="bg-white border-custom diagonal-corners overflow-hidden">
                <div class="bg-light px-4 py-3">
                    <h4 class="mb-0">@dateGroup.Key.ToString("dd/MM/yyyy")</h4>
                </div>
                <GeometricDivider />

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="px-4 py-3">Hora</th>
                                <th class="px-4 py-3">Estadio</th>
                                <th class="px-4 py-3">Grupo/Fase</th>
                                <th class="px-4 py-3 text-end">Local</th>
                                <th class="px-4 py-3 text-center">Resultado</th>
                                <th class="px-4 py-3 text-center">Tarjetas</th>
                                <th class="px-4 py-3">Visitante</th>
                                <th class="px-4 py-3">Ganador</th>
                                <th class="px-4 py-3 text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var match in dateGroup.OrderBy(match => match.Date))
                            {
                                <tr>
                                    <td class="px-4 py-3">
                                        @if (editingMatchId == match.Id)
                                        {
                                            <input class="form-control border-custom-input"
                                                   type="datetime-local"
                                                   @bind="editDate" />
                                        }
                                        else
                                        {
                                            @match.Date.ToString("HH:mm")
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (editingMatchId == match.Id)
                                        {
                                            <select class="form-select border-custom-input" @bind="editStadiumName">
                                                @foreach (var stadium in stadiums)
                                                {
                                                    <option value="@stadium.Name">@stadium.Name</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            @match.Stadium.Name
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        @if (match.Group.HasValue)
                                        {
                                            <span class="badge bg-wc-blue">Grupo @match.Group</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@match.Phase</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-end fw-bold">@match.HomeTeam.Name</td>
                                    <td class="px-4 py-3 text-center">
                                        @if (editingMatchId == match.Id)
                                        {
                                            <div class="d-flex justify-content-center align-items-center gap-2">
                                                <input type="number"
                                                       min="0"
                                                       class="form-control text-center border-custom-input score-input"
                                                       @bind="editHomeGoals" />
                                                <span>-</span>
                                                <input type="number"
                                                       min="0"
                                                       class="form-control text-center border-custom-input score-input"
                                                       @bind="editAwayGoals" />
                                            </div>
                                        }
                                        else
                                        {
                                            @FormatResult(match)
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <span class="badge" style="background-color:#f1c40f;color:#000;">
                                            🟨 @match.HomeYellowCards - @match.AwayYellowCards
                                        </span>
                                        <span class="badge bg-danger">
                                            🟥 @match.HomeRedCards - @match.AwayRedCards
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 fw-bold">@match.AwayTeam.Name</td>
                                    <td class="px-4 py-3">@(match.Winner?.Name ?? "-")</td>
                                    <td class="px-4 py-3">
                                        <div class="d-flex justify-content-center gap-2">
                                            @if (editingMatchId == match.Id)
                                            {
                                                <button class="btn btn-sm btn-wc-green" @onclick="SaveEdit">Guardar</button>
                                                <button class="btn btn-sm btn-outline-dark border-custom" @onclick="CancelEdit">Cancelar</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-light border-custom"
                                                        disabled="@(!IsEditor || match.IsLocked)"
                                                        @onclick="() => StartEdit(match)">
                                                    Editar
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                @if (editingMatchId == match.Id)
                                {
                                    <tr>
                                        <td colspan="9" class="px-4 py-3 bg-light">
                                            <div class="d-flex align-items-end gap-2 flex-wrap">
                                                <div>
                                                    <label class="form-label fw-bold mb-1 small">Equipo</label>
                                                    <select class="form-select border-custom-input" @bind="incidenceIsHome">
                                                        <option value="true">@match.HomeTeam.Name (Local)</option>
                                                        <option value="false">@match.AwayTeam.Name (Visitante)</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="form-label fw-bold mb-1 small">Tipo</label>
                                                    <select class="form-select border-custom-input" @bind="incidenceType">
                                                        <option value="Yellow">🟨 Amarilla</option>
                                                        <option value="Red">🟥 Roja</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="form-label fw-bold mb-1 small">Minuto</label>
                                                    <input type="number" min="0" max="130"
                                                           class="form-control border-custom-input score-input"
                                                           @bind="incidenceMinute" />
                                                </div>
                                                <button class="btn btn-sm btn-wc-blue" @onclick="() => RegisterIncidence(match.Id)">
                                                    <i class="bi bi-plus-lg"></i> Registrar tarjeta
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@code {
    private IEnumerable<MatchResponse> matches = Enumerable.Empty<MatchResponse>();
    private IEnumerable<StadiumResponse> stadiums = Enumerable.Empty<StadiumResponse>();

    private DateTime? filterDate;
    private string filterStadium = string.Empty;
    private string filterGroup = string.Empty;
    private string filterPhase = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private int? editingMatchId;
    private DateTime editDate;
    private string editStadiumName = string.Empty;
    private int? editHomeGoals;
    private int? editAwayGoals;

    // Campos del formulario de registro de tarjeta (modo edición).
    private string incidenceIsHome = "true";
    private string incidenceType = "Yellow";
    private int incidenceMinute = 0;

    private bool IsEditor => SessionService.IsLoggedIn() && SessionService.CurrentUserHasRole(RoleDto.Editor);

    protected override void OnInitialized()
    {
        RefreshUI();
    }

    private IEnumerable<string> availableStadiums => matches
        .Select(match => match.Stadium.Name)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct()
        .OrderBy(name => name);

    private IEnumerable<string> availableGroups => matches
        .Where(match => match.Group.HasValue)
        .Select(match => match.Group!.Value.ToString())
        .Distinct()
        .OrderBy(group => group);

    private IEnumerable<string> availablePhases => matches
        .Select(match => match.Phase)
        .Where(phase => !string.IsNullOrWhiteSpace(phase))
        .Distinct()
        .OrderBy(phase => phase);

    private IEnumerable<MatchResponse> FilteredMatches => matches
        .Where(match => !filterDate.HasValue || match.Date.Date == filterDate.Value.Date)
        .Where(match => string.IsNullOrEmpty(filterStadium) || match.Stadium.Name == filterStadium)
        .Where(match => string.IsNullOrEmpty(filterGroup) || (match.Group.HasValue && match.Group.Value.ToString() == filterGroup))
        .Where(match => string.IsNullOrEmpty(filterPhase) || match.Phase == filterPhase)
        .OrderBy(match => match.Date);

    private void StartEdit(MatchResponse match)
    {
        editingMatchId = match.Id;
        editDate = match.Date;
        editStadiumName = match.Stadium.Name;
        editHomeGoals = match.HomeGoals;
        editAwayGoals = match.AwayGoals;
        ResetIncidenceForm();
        ClearMessages();
    }

    private void SaveEdit()
    {
        if (!editingMatchId.HasValue)
            return;

        ClearMessages();

        try
        {
            var current = matches.First(match => match.Id == editingMatchId.Value);

            if (editDate != current.Date)
                TournamentService.UpdateMatchDate(editingMatchId.Value, editDate);

            if (editStadiumName != current.Stadium.Name)
                TournamentService.UpdateMatchStadium(editingMatchId.Value, FindStadiumRequest(editStadiumName));

            if (editHomeGoals.HasValue && editAwayGoals.HasValue &&
                (editHomeGoals != current.HomeGoals || editAwayGoals != current.AwayGoals))
            {
                TournamentService.SetMatchResult(editingMatchId.Value, editHomeGoals.Value, editAwayGoals.Value);
            }

            successMessage = "Partido actualizado correctamente.";
            CancelEdit();
            RefreshUI();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void RegisterIncidence(int matchId)
    {
        ClearMessages();
        try
        {
            var isHome = incidenceIsHome == "true";
            TournamentService.RegisterMatchIncidence(matchId, incidenceType, isHome, incidenceMinute);
            successMessage = "Tarjeta registrada correctamente.";
            RefreshUI();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void FinishAll()
    {
        ClearMessages();
        try
        {
            TournamentService.FinishAllMatches();
            successMessage = "Todos los partidos con resultado fueron finalizados y el ranking recalculado.";
            RefreshUI();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        editingMatchId = null;
        editDate = default;
        editStadiumName = string.Empty;
        editHomeGoals = null;
        editAwayGoals = null;
        ResetIncidenceForm();
    }

    private void ResetIncidenceForm()
    {
        incidenceIsHome = "true";
        incidenceType = "Yellow";
        incidenceMinute = 0;
    }

    private void ClearFilters()
    {
        filterDate = null;
        filterStadium = string.Empty;
        filterGroup = string.Empty;
        filterPhase = string.Empty;
    }

    private void RefreshUI()
    {
        matches = TournamentService.GetMatches();
        stadiums = StadiumService.GetAllStadiums();
    }

    private StadiumRequest FindStadiumRequest(string stadiumName)
    {
        var stadium = stadiums.First(stadium => stadium.Name == stadiumName);
        return new StadiumRequest
        {
            Name = stadium.Name,
            City = stadium.City,
            Description = stadium.Description,
            Capacity = stadium.Capacity
        };
    }

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private static string FormatResult(MatchResponse match)
    {
        return match.HomeGoals.HasValue && match.AwayGoals.HasValue
            ? $"{match.HomeGoals} - {match.AwayGoals}"
            : "-";
    }
}

<style>
    .score-input {
        width: 70px;
    }
</style>
