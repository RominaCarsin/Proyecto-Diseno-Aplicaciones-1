@using Web.Components.Shared
@page "/matches"

<div class="container-fluid p-0 space-y-6">
    
    <!-- FILTROS -->
    <div class="bg-white border-custom p-4 diagonal-corners">
        <h3 class="mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-funnel"></i> Filtros
        </h3>
        <GeometricDivider />

        <div class="row g-3 mt-2">
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha</label>
                <input type="date" @bind="filterDate" @bind:event="oninput"
                       class="form-control border-custom-input" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Estadio</label>
                <select @bind="filterStadium" class="form-select border-custom-input">
                    <option value="">Todos</option>
                    @foreach (var s in availableStadiums)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">Grupo</label>
                <select @bind="filterGroup" class="form-select border-custom-input">
                    <option value="">Todos</option>
                    @foreach (var g in groups)
                    {
                        <option value="@g">Grupo @g</option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button @onclick="ClearFilters" class="btn btn-outline-dark border-custom w-100">
                    Limpiar Filtros
                </button>
            </div>
        </div>
    </div>

    <!-- LISTA DE PARTIDOS -->
    <div class="space-y-4">
        @foreach (var match in FilteredMatches)
        {
            <div class="bg-white border-custom p-4 diagonal-corners position-relative">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex gap-3 text-muted small fw-bold">
                        <span><i class="bi bi-calendar3 me-1"></i> @match.Date</span>
                        <span><i class="bi bi-clock me-1"></i> @match.Time</span>
                        <span><i class="bi bi-geo-alt me-1"></i> @match.Stadium</span>
                        <span class="badge bg-wc-blue">Grupo @match.Group</span>
                    </div>

                    <button @onclick="() => SimulateMatch(match)" 
                            class="btn btn-sm btn-wc-green d-flex align-items-center gap-2 px-3">
                        <i class="bi bi-shuffle"></i> Simular
                    </button>
                </div>

                <div class="row align-items-center text-center">
                    <div class="col">
                        <div class="h4 mb-0 fw-bold text-end pe-4">@match.HomeTeam</div>
                    </div>

                    <div class="col-auto d-flex align-items-center gap-3">
                        <input type="number" class="form-control text-center fw-bold h3 mb-0 border-custom-input score-input"
                               value="@match.HomeScore" 
                               @onchange="@(e => HandleScoreChange(match, "home", e.Value?.ToString()))"
                               placeholder="-" />

                        <span class="h3 mb-0 opacity-25">:</span>

                        <input type="number" class="form-control text-center fw-bold h3 mb-0 border-custom-input score-input"
                               value="@match.AwayScore"
                               @onchange="@(e => HandleScoreChange(match, "away", e.Value?.ToString()))"
                               placeholder="-" />
                    </div>

                    <div class="col">
                        <div class="h4 mb-0 fw-bold text-start ps-4">@match.AwayTeam</div>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <span class="badge @GetStatusClass(match.Status)">
                        @GetStatusLabel(match.Status)
                    </span>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .score-input {
        width: 70px;
        height: 60px;
        font-size: 1.75rem !important;
    }

    .bg-success-light { background-color: #d1e7dd; color: #0f5132; }
    .bg-warning-light { background-color: #fff3cd; color: #664d03; }
    .bg-gray-light { background-color: #f8f9fa; color: #212529; border: 1px solid #dee2e6; }
</style>

@code {

    private List<MatchModel> matches = new()
    {
        new() { Id = "1", Date = "2026-06-11", Time = "16:00", Stadium = "Estadio Azteca", Group = "A", HomeTeam = "México", AwayTeam = "Camerún", Status = "scheduled" },
        new() { Id = "2", Date = "2026-06-12", Time = "13:00", Stadium = "MetLife Stadium", Group = "B", HomeTeam = "Argentina", AwayTeam = "Canadá", HomeScore = 2, AwayScore = 1, Status = "completed" }
    };

    private DateTime? filterDate;
    private string filterStadium = "";
    private string filterGroup = "";

    private string[] availableStadiums = { "Estadio Azteca", "MetLife Stadium", "AT&T Stadium", "BMO Field" };
    private string[] groups = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L" };

    private IEnumerable<MatchModel> FilteredMatches => matches.Where(m =>
        (string.IsNullOrEmpty(filterStadium) || m.Stadium == filterStadium) &&
        (string.IsNullOrEmpty(filterGroup) || m.Group == filterGroup)
    );

    private void HandleScoreChange(MatchModel match, string team, string? value)
    {
        int? score = int.TryParse(value, out int result) ? result : null;
        
        if (team == "home") match.HomeScore = score;
        else match.AwayScore = score;

        match.Status = (match.HomeScore.HasValue && match.AwayScore.HasValue) ? "completed" : "scheduled";
    }

    private void SimulateMatch(MatchModel match)
    {
        var random = new Random();
        match.HomeScore = random.Next(0, 5);
        match.AwayScore = random.Next(0, 5);
        match.Status = "completed";
    }

    private void ClearFilters()
    {
        filterStadium = "";
        filterGroup = "";
    }

    private string GetStatusClass(string status) => status switch
    {
        "completed" => "bg-success-light",
        "in_progress" => "bg-warning-light",
        _ => "bg-gray-light"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "completed" => "Finalizado",
        "in_progress" => "En Progreso",
        _ => "Programado"
    };

    public class MatchModel
    {
        public string Id { get; set; } = "";
        public string Date { get; set; } = "";
        public string Time { get; set; } = "";
        public string Stadium { get; set; } = "";
        public string Group { get; set; } = "";
        public string HomeTeam { get; set; } = "";
        public string AwayTeam { get; set; } = "";
        public int? HomeScore { get; set; }
        public int? AwayScore { get; set; }
        public string Status { get; set; } = "scheduled";
    }
}