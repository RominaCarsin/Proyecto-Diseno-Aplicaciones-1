@page "/Groups/Create"
@rendermode InteractiveServer
@using DTOs
@using IServices
@inject IGroupService GroupService
@inject ITeamService TeamService
@inject IFixtureService FixtureService

<div class="page-wrap">

    <div class="ph">
        <h1 class="pt">GroupPhase · Phase de grupos</h1>
        <p class="ps">12 grupos · WorldCupPlanner 2026</p>
    </div>

    @if (!_fixtureGenerated)
    {
        <div class="card">
            <div class="card-header">
                <span class="card-title">Generar fixture</span>
            </div>
            <div class="card-body">
                <div class="fg">
                    <label class="fl">Semilla (SemillaGroupPhase) <span class="req">*</span></label>
                    <input class="finput" type="number" @bind="_seed" />
                </div>
                <div class="fg">
                    <label class="fl">Fecha de inicio</label>
                    <input class="finput" type="date" @bind="_startDate" />
                </div>
                <div style="margin-top: 0.5rem; font-size: 13px; color: #888;">
                    Equipos cargados: @_teamCount / 48 &nbsp;·&nbsp;
                    Estadios cargados: @_stadiumCount / 4 mínimo
                </div>
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert-box err" style="margin-top: 1rem;">@_errorMessage</div>
                }
                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <div class="alert-box suc" style="margin-top: 1rem;">✓ @_successMessage</div>
                }
            </div>
            <div class="card-footer">
                <button class="btn-p"
                        disabled="@(!CanGenerate)"
                        @onclick="GenerateFixture">
                    Generar fixture
                </button>
                @if (!CanGenerate)
                {
                    <span style="font-size: 13px; color: #888; margin-left: 1rem;">
                        Necesitás 48 equipos y al menos 4 estadios.
                    </span>
                }
            </div>
        </div>
    }

    @if (_fixtureGenerated)
    {
        <div class="card" style="margin-top: 1rem;">
            <div class="card-header">
                <span class="card-title">Simular fase de grupos</span>
            </div>
            <div class="card-body">
                <div class="fg">
                    <label class="fl">Semilla (SemillaSimulation) <span class="req">*</span></label>
                    <input class="finput" type="number" @bind="_simulationSeed" />
                </div>
                @if (!string.IsNullOrEmpty(_simulationErrorMessage))
                {
                    <div class="alert-box err" style="margin-top: 1rem;">@_simulationErrorMessage</div>
                }
                @if (!string.IsNullOrEmpty(_simulationSuccessMessage))
                {
                    <div class="alert-box suc" style="margin-top: 1rem;">✓ @_simulationSuccessMessage</div>
                }
            </div>
            <div class="card-footer">
                <button class="btn-p" @onclick="SimulateGroupStage">
                    Simular fase de grupos
                </button>
            </div>
        </div>
    }

    @if (!_groups.Any())
    {
        <div class="card" style="margin-top: 1rem;">
            <div class="card-body">
                <p style="color: #888;">No hay grupos generados aún.</p>
            </div>
        </div>
    }
    else
    {
        <div class="groups-grid">
            @foreach (var group in _groups)
            {
                <div class="group-card @(_selectedLabel == group.Label ? "group-card--active" : "")"
                     @onclick="() => SelectGroup(group.Label)">
                    <div class="group-card-header">
                        <span class="group-label">Grupo @group.Label</span>
                        <span class="group-teams-count">@group.Teams.Count/4</span>
                    </div>
                    <div class="group-card-teams">
                        @foreach (var team in group.Teams)
                        {
                            <span class="group-team-name">@team.Name</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (_selectedLabel.HasValue && _selectedGroup is not null)
        {
            <div class="card" style="margin-top: 1.5rem;">
                <div class="card-header">
                    <span class="card-title">Grupo @_selectedLabel — Tabla de posiciones</span>
                </div>
                <div class="card-body" style="overflow-x: auto;">
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Equipo</th>
                                <th>Pts</th>
                                <th>GF</th>
                                <th>DG</th>
                                <th>Confederación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var standings = _selectedGroup.Teams
                                    .OrderByDescending(t => t.Points)
                                    .ThenByDescending(t => t.GoalDifference)
                                    .ThenByDescending(t => t.GoalsInFavor)
                                    .ToList();
                                int pos = 1;
                            }
                            @foreach (var team in standings)
                            {
                                <tr style="@(pos <= 2 ? "background: #f0fdf4; color: #166534;" : "")">
                                    <td>@pos</td>
                                    <td>@team.Name</td>
                                    <td style="font-weight: 600;">@team.Points</td>
                                    <td>@team.GoalsInFavor</td>
                                    <td>@(team.GoalDifference >= 0 ? "+" : "")@team.GoalDifference</td>
                                    <td>@team.ConfederationName</td>
                                </tr>
                                pos++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card" style="margin-top: 1rem;">
                <div class="card-header">
                    <span class="card-title">Grupo @_selectedLabel — Partidos</span>
                </div>
                <div class="card-body" style="overflow-x: auto;">
                    @if (!string.IsNullOrEmpty(_matchErrorMessage))
                    {
                        <div class="alert-box err" style="margin-bottom: 1rem;">@_matchErrorMessage</div>
                    }
                    @if (!string.IsNullOrEmpty(_matchSuccessMessage))
                    {
                        <div class="alert-box suc" style="margin-bottom: 1rem;">✓ @_matchSuccessMessage</div>
                    }

                    @if (!_selectedGroup.Matches.Any())
                    {
                        <p style="color: #888;">No hay partidos registrados para este grupo.</p>
                    }
                    else
                    {
                        <table>
                            <thead>
                                <tr>
                                    <th>Local</th>
                                    <th>Resultado</th>
                                    <th>Visitante</th>
                                    <th>Fecha</th>
                                    <th>Estadio</th>
                                    <th>Ganador</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var match in _selectedGroup.Matches.OrderBy(m => m.Date))
                                {
                                    <tr style="@(match.Status == "Finished" ? "opacity: 0.6; background: #f9f9f9;" : "")">
                                        <td>@match.HomeTeam.Name</td>
                                        <td style="text-align: center; font-weight: 600;">
                                            @if (match.HasResult)
                                            {
                                                @($"{match.HomeGoals} - {match.AwayGoals}")
                                            }
                                            else
                                            {
                                                <span style="color: #888;">vs</span>
                                            }
                                        </td>
                                        <td>@match.AwayTeam.Name</td>
                                        <td>@match.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@match.Stadium.Name</td>
                                        <td>@(match.Winner?.Name ?? "-")</td>
                                        <td>
                                            @if (match.Status == "Finished")
                                            {
                                                <span class="badge-finished">Finalizado</span>
                                            }
                                            else
                                            {
                                                <span class="badge-pending">Pendiente</span>
                                            }
                                        </td>
                                        <td>
                                            @if (match.Status == "NotFinished")
                                            {
                                                {
                                                    @if (_editingMatchId == match.Id)
                                                    {
                                                        <div style="display: flex; align-items: center; gap: 6px;">
                                                            <input class="finput"
                                                                   type="number" min="0"
                                                                   style="width: 60px;"
                                                                   @bind="_editHomeGoals" />
                                                            <span>-</span>
                                                            <input class="finput"
                                                                   type="number" min="0"
                                                                   style="width: 60px;"
                                                                   @bind="_editAwayGoals" />
                                                            <button class="btn-p"
                                                                    @onclick="() => SaveResult(match.Id)">
                                                                Guardar
                                                            </button>
                                                            <button class="btn btn-g"
                                                                    @onclick="CancelEdit">
                                                                Cancelar
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-s"
                                                                @onclick="() => StartEditResult(match.Id)">
                                                            Cargar resultado
                                                        </button>
                                                    }
                                                }

                                                @if (_editingMatchId != match.Id)
                                                {
                                                    <button class="btn btn-w"
                                                            style="margin-left: 4px;"
                                                            @onclick="() => FinishMatch(match.Id)">
                                                        Terminar
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #888;">🔒</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        }
    }

</div>

<style>
    .groups-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .group-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 1rem;
        cursor: pointer;
        transition: border-color 0.15s;
    }

    .group-card:hover { border-color: #aaa; }

    .group-card--active {
        border: 2px solid #3b82f6;
        background: #eff6ff;
    }

    .group-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .group-label { font-size: 16px; font-weight: 500; }
    .group-teams-count { font-size: 12px; color: #888; }

    .group-card-teams {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .group-team-name { font-size: 13px; color: #555; }

    .btn-w {
        background: #f59e0b;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        font-size: 13px;
    }

    .btn-w:hover { background: #d97706; }

    .badge-finished {
        background: #fee2e2;
        color: #991b1b;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 12px;
        font-weight: 500;
    }

    .badge-pending {
        background: #fef9c3;
        color: #854d0e;
        border-radius: 4px;
        padding: 2px 8px;
        font-size: 12px;
        font-weight: 500;
    }
</style>

@code {
    private int _seed = 42;
    private DateTime _startDate = new DateTime(2026, 6, 1);
    private int _teamCount;
    private int _stadiumCount;
    private bool _fixtureGenerated;

    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private string _matchErrorMessage = string.Empty;
    private string _matchSuccessMessage = string.Empty;
    private string _simulationErrorMessage = string.Empty;
    private string _simulationSuccessMessage = string.Empty;

    private int _simulationSeed = 42;
    private List<GroupResponse> _groups = new();
    private char? _selectedLabel;
    private GroupResponse? _selectedGroup;

    private int? _editingMatchId;
    private int _editHomeGoals;
    private int _editAwayGoals;

    private bool CanGenerate => _teamCount >= 48 && _stadiumCount >= 4;

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        _groups = GroupService.GetGroups().OrderBy(g => g.Label).ToList();
        _teamCount = TeamService.GetTeams().Count();
        _stadiumCount = FixtureService.GetStadiumCount();
        _fixtureGenerated = _groups.Any();

        if (_selectedLabel.HasValue)
            _selectedGroup = _groups.FirstOrDefault(g => g.Label == _selectedLabel);
    }

    private void GenerateFixture()
    {
        ClearMessages();
        try
        {
            FixtureService.GenerateFixture(_seed, _startDate);
            _successMessage = "GroupPhase generado correctamente.";
            LoadData();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SimulateGroupStage()
    {
        ClearMessages();
        try
        {
            FixtureService.SimulateGroupStage(_simulationSeed);
            _simulationSuccessMessage = "Resultados simulados correctamente.";
            LoadData();
        }
        catch (Exception ex)
        {
            _simulationErrorMessage = ex.Message;
        }
    }

    private void SelectGroup(char label)
    {
        if (_selectedLabel == label)
        {
            _selectedLabel = null;
            _selectedGroup = null;
            return;
        }

        _selectedLabel = label;
        _selectedGroup = _groups.FirstOrDefault(g => g.Label == label);
        CancelEdit();
        ClearMatchMessages();
    }

    private void StartEditResult(int matchId)
    {
        _editingMatchId = matchId;
        _editHomeGoals = 0;
        _editAwayGoals = 0;
        ClearMatchMessages();
    }

    private void SaveResult(int matchId)
    {
        ClearMatchMessages();
        try
        {
            GroupService.SetMatchResult(_selectedLabel!.Value, matchId, _editHomeGoals, _editAwayGoals);
            _matchSuccessMessage = "Resultado cargado correctamente.";
            CancelEdit();
            LoadData();
        }
        catch (Exception ex)
        {
            _matchErrorMessage = ex.Message;
        }
    }

    private void FinishMatch(int matchId)
    {
        ClearMatchMessages();
        try
        {
            GroupService.FinishMatch(_selectedLabel!.Value, matchId);
            _matchSuccessMessage = "Partido terminado correctamente.";
            LoadData();
        }
        catch (Exception ex)
        {
            _matchErrorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        _editingMatchId = null;
        _editHomeGoals = 0;
        _editAwayGoals = 0;
    }

    private void ClearMessages()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;
        _simulationErrorMessage = string.Empty;
        _simulationSuccessMessage = string.Empty;
    }

    private void ClearMatchMessages()
    {
        _matchErrorMessage = string.Empty;
        _matchSuccessMessage = string.Empty;
    }
}