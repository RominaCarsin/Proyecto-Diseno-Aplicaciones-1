@using Web.Components.Shared
@page "/stadiums"

<div class="container-fluid p-0 space-y-6">
    
    <!-- FORMULARIO DE ESTADIOS -->
    <div class="bg-white border-custom p-4 diagonal-corners">
        <h3 class="mb-3">@(editingStadium == null ? "Crear Estadio" : "Editar Estadio")</h3>
        <GeometricDivider />

        <div class="row g-3 mb-4 mt-2">
            <div class="col-md-4">
                <label class="form-label fw-bold">Nombre</label>
                <input type="text" @bind="formData.Name" placeholder="Nombre del estadio"
                       class="form-control border-custom-input" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Ciudad</label>
                <input type="text" @bind="formData.City" placeholder="Ciudad"
                       class="form-control border-custom-input" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Capacidad</label>
                <input type="number" @bind="formData.Capacity" min="1"
                       class="form-control border-custom-input" placeholder="Capacidad" />
            </div>
        </div>

        <div class="d-flex gap-2">
            @if (editingStadium != null)
            {
                <button @onclick="UpdateStadium" class="btn btn-wc-blue px-4">Actualizar</button>
                <button @onclick="CancelEdit" class="btn btn-outline-dark border-custom px-4">Cancelar</button>
            }
            else
            {
                <button @onclick="CreateStadium" class="btn btn-wc-red px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i> Crear
                </button>
            }
        </div>
    </div>

    <!-- TABLA DE ESTADIOS -->
    <div class="bg-white border-custom diagonal-corners overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light border-bottom-2">
                    <tr>
                        <th class="px-6 py-3 text-left">Nombre</th>
                        <th class="px-6 py-3 text-left">Ciudad</th>
                        <th class="px-6 py-3 text-left">Capacidad</th>
                        <th class="px-6 py-3 text-left">Estado</th>
                        <th class="px-6 py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stadium in stadiums)
                    {
                        <tr class="hover-bg-custom">
                            <td class="px-6 py-3 align-middle fw-medium">@stadium.Name</td>
                            <td class="px-6 py-3 align-middle">@stadium.City</td>
                            <td class="px-6 py-3 align-middle font-monospace">@stadium.Capacity.ToString("N0")</td>
                            <td class="px-6 py-3 align-middle">
                                <span class="badge @(stadium.IsActive ? "bg-success-light" : "bg-secondary-light")">
                                    @(stadium.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="px-6 py-3 align-middle">
                                <div class="d-flex justify-content-center gap-2">
                                    <button @onclick="() => EditStadium(stadium)" class="btn btn-sm btn-light border-custom">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button @onclick="() => DeleteStadium(stadium.Id)" class="btn btn-sm btn-outline-danger border-custom">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<StadiumModel> stadiums = new()
    {
        new() { Id = Guid.NewGuid(), Name = "Estadio Azteca", City = "Ciudad de México", Capacity = 87523, IsActive = true },
        new() { Id = Guid.NewGuid(), Name = "MetLife Stadium", City = "Nueva York", Capacity = 82500, IsActive = true },
        new() { Id = Guid.NewGuid(), Name = "AT&T Stadium", City = "Dallas", Capacity = 80000, IsActive = true },
        new() { Id = Guid.NewGuid(), Name = "BMO Field", City = "Toronto", Capacity = 45500, IsActive = true }
    };

    private StadiumModel formData = new();
    private StadiumModel? editingStadium = null;

    private void CreateStadium()
    {
        if (string.IsNullOrWhiteSpace(formData.Name) || string.IsNullOrWhiteSpace(formData.City) || formData.Capacity <= 0) 
            return;

        stadiums.Add(new StadiumModel
        {
            Id = Guid.NewGuid(),
            Name = formData.Name,
            City = formData.City,
            Capacity = formData.Capacity,
            IsActive = true
        });

        ResetForm();
    }

    private void EditStadium(StadiumModel stadium)
    {
        editingStadium = stadium;
        formData = new StadiumModel
        {
            Name = stadium.Name,
            City = stadium.City,
            Capacity = stadium.Capacity
        };
    }

    private void UpdateStadium()
    {
        if (editingStadium == null || string.IsNullOrWhiteSpace(formData.Name) || 
            string.IsNullOrWhiteSpace(formData.City) || formData.Capacity <= 0) 
            return;

        editingStadium.Name = formData.Name;
        editingStadium.City = formData.City;
        editingStadium.Capacity = formData.Capacity;

        CancelEdit();
    }

    private void CancelEdit() => ResetForm();

    private void DeleteStadium(Guid id)
    {
        // En una app real usarías un servicio de JS para el Confirm
        stadiums.RemoveAll(s => s.Id == id);
    }

    private void ResetForm()
    {
        editingStadium = null;
        formData = new StadiumModel();
    }

    public class StadiumModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string City { get; set; } = "";
        public int Capacity { get; set; }
        public bool IsActive { get; set; }
    }
}