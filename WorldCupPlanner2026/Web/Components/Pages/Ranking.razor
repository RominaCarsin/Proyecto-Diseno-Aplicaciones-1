@using Web.Components.Shared
@using DTOs
@using IServices
@page "/ranking"
@inject ITeamService TeamService
@inject ISessionService SessionService

<div class="container-fluid p-0 space-y-6">
    @if (!CanView)
    {
        <div class="bg-white border-custom p-4 diagonal-corners text-muted">
            No tienes permisos para ver el ranking.
        </div>
    }
    else
    {
        <div class="bg-white border-custom p-4 diagonal-corners">
            <h3 class="mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-line"></i> Ranking de equipos
            </h3>
            <GeometricDivider />
            <p class="text-muted mt-3 mb-0">
                Ranking FIFA actualizado tras cada partido finalizado. Ordenado de mayor a menor.
            </p>
        </div>

        <div class="bg-white border-custom diagonal-corners overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light border-bottom-2">
                        <tr>
                            <th class="px-4 py-3 text-center">#</th>
                            <th class="px-4 py-3">Bandera</th>
                            <th class="px-4 py-3">Equipo</th>
                            <th class="px-4 py-3">Confederacion</th>
                            <th class="px-4 py-3 text-end">Ranking FIFA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!teams.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-4 py-4 text-center text-muted">
                                    No hay equipos registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var position = 1;
                            foreach (var team in teams)
                            {
                                <tr>
                                    <td class="px-4 py-3 align-middle text-center fw-bold">@position</td>
                                    <td class="px-4 py-3 align-middle">
                                        @if (!string.IsNullOrWhiteSpace(team.FlagBase64))
                                        {
                                            <img src="data:image/png;base64,@team.FlagBase64"
                                                 alt="Bandera de @team.Name"
                                                 style="height: 24px; border: 1px solid var(--wc-border);" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 align-middle fw-medium">@team.Name</td>
                                    <td class="px-4 py-3 align-middle">
                                        <span class="badge-conf @GetConfColor(team.ConfederationName)">
                                            @team.ConfederationName
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 align-middle text-end fw-bold">@team.RankingFifa</td>
                                </tr>
                                position++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<TeamResponse> teams = Enumerable.Empty<TeamResponse>();

    private bool CanView =>
        SessionService.IsLoggedIn() &&
        (SessionService.CurrentUserHasRole(RoleDto.Admin) ||
         SessionService.CurrentUserHasRole(RoleDto.Editor) ||
         SessionService.CurrentUserHasRole(RoleDto.Journalist));

    protected override void OnInitialized()
    {
        if (CanView)
            RefreshUI();
    }

    private void RefreshUI()
    {
        teams = TeamService.GetTeamsByRanking();
    }

    private string GetConfColor(string conf) => conf switch
    {
        "AFC" => "conf-afc",
        "CAF" => "conf-caf",
        "CONCACAF" => "conf-concacaf",
        "CONMEBOL" => "conf-conmebol",
        "OFC" => "conf-ofc",
        "UEFA" => "conf-uefa",
        _ => "bg-light"
    };
}
