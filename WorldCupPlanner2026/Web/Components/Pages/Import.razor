@using Web.Components.Shared
@using DTOs
@using IServices
@page "/import"
@using Microsoft.AspNetCore.Components.Forms
@using System.Text
@inject ISessionService SessionService
@inject ITeamService TeamService

<div class="row g-4">
    @if (!IsEditor)
    {
        <div class="col-12">
            <div class="bg-white border-custom p-4 diagonal-corners text-muted">
                No tienes permisos para importar equipos.
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-8 space-y-6">
            <div class="dropzone-container @(isDragging ? "dragging" : "")"
                 @ondragover="HandleDragOver"
                 @ondragleave="HandleDragLeave"
                 @ondrop="HandleDrop">

                <i class="bi bi-cloud-arrow-up display-1 opacity-25 mb-3"></i>
                <h3 class="mb-2">Importar archivo CSV</h3>
                <p class="text-muted text-center mb-4">
                    Encabezado requerido: Nombre,Confederaci&oacute;n,RankingFIFA
                </p>

                <label class="btn btn-wc-blue px-4 py-2 position-relative cursor-pointer">
                    Seleccionar Archivo
                    <InputFile OnChange="HandleFileSelected" accept=".csv" class="hidden-input" />
                </label>

                @if (selectedFile != null)
                {
                    <div class="mt-4 d-flex align-items-center gap-2 text-primary fw-bold">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>@selectedFile.Name</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger border-custom py-2">@errorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success border-custom py-2">@successMessage</div>
            }

            @if (previewResult != null)
            {
                <div class="bg-white border-custom diagonal-corners">
                    <div class="bg-light px-4 py-3 d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Vista previa</h4>
                        <span class="text-muted small">
                            @previewResult.SuccessfulRows validas / @previewResult.FailedRows con error
                        </span>
                    </div>
                    <GeometricDivider />

                    <div class="p-4 overflow-auto">
                        <table class="table table-sm text-sm">
                            <thead>
                                <tr class="border-bottom-2">
                                    <th class="px-3 py-2 text-start">Fila</th>
                                    <th class="px-3 py-2 text-start">Nombre</th>
                                    <th class="px-3 py-2 text-start">Confederacion</th>
                                    <th class="px-3 py-2 text-start">Ranking FIFA</th>
                                    <th class="px-3 py-2 text-start">Estado</th>
                                    <th class="px-3 py-2 text-start">Detalle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in previewResult.Rows)
                                {
                                    <tr class="@(row.Success ? "" : "bg-danger-soft")">
                                        <td class="px-3 py-2">@row.RowNumber</td>
                                        <td class="px-3 py-2">@row.Team?.Name</td>
                                        <td class="px-3 py-2">@row.Team?.ConfederationName</td>
                                        <td class="px-3 py-2">@row.Team?.RankingFifa</td>
                                        <td class="px-3 py-2">
                                            <span class="badge @(row.Success ? "bg-success-soft text-success" : "bg-danger-soft text-danger")">
                                                @(row.Success ? "Valida" : "Error")
                                            </span>
                                        </td>
                                        <td class="px-3 py-2">@row.ErrorMessage</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <GeometricDivider />
                    <div class="px-4 py-3 bg-light d-flex justify-content-end">
                        <button @onclick="ProcessImport"
                                disabled="@(previewResult.SuccessfulRows == 0 || isImporting)"
                                class="btn btn-wc-green px-5">
                            @(isImporting ? "Importando..." : "Importar datos")
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4 space-y-6">
            <div class="bg-white border-custom p-4 diagonal-corners">
                <h4 class="mb-3">Resultado</h4>
                <GeometricDivider />

                @if (previewResult == null)
                {
                    <div class="text-muted mt-3">Selecciona un CSV para validar los datos.</div>
                }
                else
                {
                    <div class="mt-3 space-y-3">
                        <div class="d-flex justify-content-between">
                            <span>Total</span>
                            <strong>@previewResult.TotalRows</strong>
                        </div>
                        <div class="d-flex justify-content-between text-success">
                            <span>Validas</span>
                            <strong>@previewResult.SuccessfulRows</strong>
                        </div>
                        <div class="d-flex justify-content-between text-danger">
                            <span>Errores</span>
                            <strong>@previewResult.FailedRows</strong>
                        </div>
                    </div>
                }
            </div>

            <div class="bg-white border-custom p-4 diagonal-corners">
                <h4 class="mb-3">Formato de CSV</h4>
                <GeometricDivider />
                <div class="text-sm mt-3 space-y-3 text-muted">
                    <p>Columnas obligatorias exactas:</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge border text-dark">Nombre</span>
                        <span class="badge border text-dark">Confederaci&oacute;n</span>
                        <span class="badge border text-dark">RankingFIFA</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IBrowserFile? selectedFile;
    private string csvContent = string.Empty;
    private TeamImportResult? previewResult;
    private bool isDragging;
    private bool isImporting;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private bool IsEditor => SessionService.IsLoggedIn() && SessionService.CurrentUserHasRole(RoleDto.Editor);

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        await LoadPreview();
    }

     private async Task LoadPreview()
     {
         ClearMessages();

         if (selectedFile == null)
             return;

         try
         {
             await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024);
             using var reader = new StreamReader(stream, Encoding.UTF8, detectEncodingFromByteOrderMarks: true);
             csvContent = await reader.ReadToEndAsync();
             previewResult = TeamService.PreviewImport(csvContent);
         }
         catch (Exception ex)
         {
             previewResult = null;
             errorMessage = ex.Message;
         }
     }

     private void ProcessImport()
     {
         if (!IsEditor || string.IsNullOrWhiteSpace(csvContent))
             return;

         ClearMessages();
         isImporting = true;

         try
         {
             previewResult = TeamService.Import(csvContent);
             successMessage = $"Importacion finalizada: {previewResult.SuccessfulRows} filas importadas, {previewResult.FailedRows} errores.";
         }
         catch (Exception ex)
         {
             errorMessage = ex.Message;
         }
         finally
         {
             isImporting = false;
         }
     }

    private void HandleDragOver() => isDragging = true;
    private void HandleDragLeave() => isDragging = false;
    private void HandleDrop() => isDragging = false;

    private void ClearMessages()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }
}

<style>
    .dropzone-container {
        background: white;
        border: 4px dashed var(--wc-border);
        padding: 4rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border-radius: 0;
    }

    .dropzone-container.dragging {
        border-color: var(--wc-blue);
        background-color: rgba(21, 32, 102, 0.05);
        transform: scale(1.01);
    }

    @* Si se ve mal volver a ponerlo *@
    
    .hidden-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .bg-success-soft {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }

    .bg-danger-soft {
        background-color: rgba(220, 53, 69, 0.1) !important;
    }
</style>
