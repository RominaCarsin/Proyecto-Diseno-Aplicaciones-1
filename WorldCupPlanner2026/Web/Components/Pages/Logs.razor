@using Web.Components.Shared
@using DTOs
@using IServices
@using Domain
@page "/logs"
@inject ISessionService SessionService
@inject IAuditService AuditService

<div class="container-fluid p-0 space-y-6">
    
    @if (!IsAdmin)
    {
        <div class="bg-white border-custom p-4 diagonal-corners text-muted">
            No tienes permisos para ver la auditoría.
        </div>
    }
    else
    {
        @* --- FILTROS DE AUDITORÍA --- *@
        <div class="bg-white border-custom p-4 diagonal-corners">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h3 class="mb-0">Filtros de Auditoría</h3>
                <div class="d-flex gap-2">
                    <span class="badge bg-success-soft text-success px-3 py-2 cursor-pointer">Éxito</span>
                    <span class="badge bg-info-soft text-info px-3 py-2 cursor-pointer">Info</span>
                    <span class="badge bg-warning-soft text-warning px-3 py-2 cursor-pointer">Advertencia</span>
                    <span class="badge bg-danger-soft text-danger px-3 py-2 cursor-pointer">Error</span>
                </div>
            </div>

            <GeometricDivider />

            <div class="row g-4 mt-2">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Usuario</label>
                    <select class="form-select border-custom-input" @bind="filterUser" @bind:after="ApplyFilters">
                        <option value="">Todos los usuarios</option>
                        @foreach (var email in allUsers)
                        {
                            <option value="@email">@email</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Desde</label>
                    <input type="datetime-local" class="form-control border-custom-input"
                           @bind="filterFrom" @bind:after="ApplyFilters" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Hasta</label>
                    <input type="datetime-local" class="form-control border-custom-input"
                           @bind="filterTo" @bind:after="ApplyFilters" />
                </div>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button class="btn btn-outline-secondary border-custom btn-sm" @onclick="ClearFilters">
                    <i class="bi bi-x-circle me-1"></i> Limpiar filtros
                </button>
            </div>        </div>

        @* --- TABLA DE LOGS --- *@
        <div class="bg-white border-custom diagonal-corners overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr class="border-bottom-2">
                            <th class="px-4 py-3">Timestamp</th>
                            <th class="px-4 py-3">Acción</th>
                            <th class="px-4 py-3">Usuario</th>
                            <th class="px-4 py-3">Severidad</th>
                            <th class="px-4 py-3">Detalles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!logs.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-4 py-4 text-center text-muted">
                                    No hay logs disponibles.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in logs)
                            {
                                <tr>
                                    <td class="px-4 py-3 font-monospace text-sm">
                                        @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </td>
                                    <td class="px-4 py-3 fw-bold">@log.Action</td>
                                    <td class="px-4 py-3 text-muted text-sm">@log.ActorEmail</td>
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="@GetSeverityIcon(log) @GetSeverityTextColor(log)"></i>
                                            <span class="badge @GetSeverityClass(log) px-2 py-1">
                                                @GetSeverity(log)
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3 text-sm">@log.Details</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    public enum LogSeverity { Info, Success, Warning, Error }

    private List<AuditLog> allLogs = new();
    private List<AuditLog> logs = new();
    private List<string> allUsers = new();

    private string filterUser = string.Empty;
    private DateTime? filterFrom;
    private DateTime? filterTo;

    private bool IsAdmin => SessionService.IsLoggedIn() && SessionService.CurrentUserHasRole(RoleDto.Admin);

    protected override void OnInitialized()
    {
        if (!IsAdmin) return;

        allLogs = AuditService.GetAll()
            .OrderByDescending(log => log.Timestamp)
            .ToList();

        allUsers = allLogs
            .Select(l => l.ActorEmail)
            .Where(e => !string.IsNullOrWhiteSpace(e))
            .Distinct()
            .OrderBy(e => e)
            .ToList();

        logs = allLogs;
    }

    private void ApplyFilters()
    {
        var fromUtc = filterFrom.HasValue
            ? DateTime.SpecifyKind(filterFrom.Value, DateTimeKind.Local).ToUniversalTime()
            : (DateTime?)null;

        var toUtc = filterTo.HasValue
            ? DateTime.SpecifyKind(filterTo.Value, DateTimeKind.Local).ToUniversalTime()
            : (DateTime?)null;

        logs = allLogs
            .Where(l => string.IsNullOrEmpty(filterUser) || l.ActorEmail == filterUser)
            .Where(l => fromUtc == null || l.Timestamp >= fromUtc.Value)
            .Where(l => toUtc == null || l.Timestamp <= toUtc.Value)
            .ToList();
    }

    private void ClearFilters()
    {
        filterUser = string.Empty;
        filterFrom = null;
        filterTo   = null;
        logs       = allLogs;
    }

    private LogSeverity GetSeverity(AuditLog log)
    {
        var action = (log.Action ?? string.Empty).ToLowerInvariant();

        if (action.Contains("error") || action.Contains("fall"))
            return LogSeverity.Error;

        if (action.Contains("elimin") || action.Contains("revoc"))
            return LogSeverity.Warning;

        if (action.Contains("cread") || action.Contains("agreg") || action.Contains("import") || action.Contains("simul"))
            return LogSeverity.Success;

        if (action.Contains("actualiz") || action.Contains("cambi") || action.Contains("result") || action.Contains("finaliz"))
            return LogSeverity.Info;

        return LogSeverity.Info;
    }

    private string GetSeverityIcon(AuditLog log) => GetSeverity(log) switch
    {
        LogSeverity.Success => "bi bi-check-circle-fill",
        LogSeverity.Info => "bi bi-info-circle-fill",
        LogSeverity.Warning => "bi bi-exclamation-triangle-fill",
        LogSeverity.Error => "bi bi-x-circle-fill",
        _ => "bi bi-info-circle"
    };

    private string GetSeverityClass(AuditLog log) => GetSeverity(log) switch
    {
        LogSeverity.Success => "bg-success-soft text-success",
        LogSeverity.Info => "bg-info-soft text-info",
        LogSeverity.Warning => "bg-warning-soft text-warning",
        LogSeverity.Error => "bg-danger-soft text-danger",
        _ => "bg-light text-dark"
    };

    private string GetSeverityTextColor(AuditLog log) => GetSeverity(log) switch
    {
        LogSeverity.Success => "text-success",
        LogSeverity.Info => "text-info",
        LogSeverity.Warning => "text-warning",
        LogSeverity.Error => "text-danger",
        _ => ""
    };
}

<style>
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-info-soft { background-color: rgba(13, 202, 240, 0.1); }
    .bg-warning-soft { background-color: rgba(255, 193, 7, 0.1); }
    .bg-danger-soft { background-color: rgba(220, 53, 69, 0.1); }
    
    .cursor-pointer { cursor: pointer; }
    
    .table-hover tbody tr:hover {
        background-color: var(--wc-bg) !important;
    }

    .border-bottom-2 {
        border-bottom: 2px solid var(--wc-border) !important;
    }
</style>