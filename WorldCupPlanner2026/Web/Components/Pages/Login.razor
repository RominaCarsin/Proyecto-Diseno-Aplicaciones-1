@page "/login"
@rendermode InteractiveServer
@using DTOs
@using IServices
@inject ISessionService SessionService
@inject IUserService UserService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · WorldCupPlanner 2026</PageTitle>

<div class="login-page">

    <div class="decorative-ball"></div>

    <section class="login-container">

        <div class="login-header">

            <div class="trophy-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8 21h8" />
                    <path d="M12 17v4" />
                    <path d="M7 4h10v4a5 5 0 0 1-10 0V4Z" />
                    <path d="M7 6H4v2a4 4 0 0 0 4 4" />
                    <path d="M17 6h3v2a4 4 0 0 1-4 4" />
                </svg>
            </div>

            <h1>
                WorldCupPlanner <span>2026</span>
            </h1>

            <p>
                @(_showRegister ? "Crea tu cuenta 👋" : "Bienvenido de nuevo 👋")
            </p>

        </div>

        <div class="login-card">

            @if (!_showRegister)
            {
                <div class="form-group">
                    <label>Email</label>

                    <div class="input-wrapper @(_emailInvalid ? "input-invalid" : "")">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 21a8 8 0 0 0-16 0" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>

                        <input type="email"
                               placeholder="Ingresa tu email"
                               @bind="_email"
                               @bind:event="oninput" />
                    </div>

                    @if (_emailInvalid)
                    {
                        <span class="field-error">El email es obligatorio</span>
                    }
                </div>

                <div class="form-group">
                    <label>Contraseña</label>

                    <div class="input-wrapper @(_passwordInvalid ? "input-invalid" : "")">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                        </span>

                        <input type="@(_showPassword ? "text" : "password")"
                               placeholder="Ingresa tu contraseña"
                               @bind="_password"
                               @bind:event="oninput" />

                        <button type="button"
                                class="eye-button"
                                @onclick="TogglePasswordVisibility">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>

                    @if (_passwordInvalid)
                    {
                        <span class="field-error">La contraseña es obligatoria</span>
                    }
                </div>
            }
            else
            {
                <div class="register-row">
                    <div class="form-group">
                        <label>Nombre</label>

                        <div class="input-wrapper @(_nameInvalid ? "input-invalid" : "")">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 21a8 8 0 0 0-16 0" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </span>

                            <input type="text"
                                   placeholder="Nombre"
                                   @bind="_name"
                                   @bind:event="oninput" />
                        </div>

                        @if (_nameInvalid)
                        {
                            <span class="field-error">El nombre es obligatorio</span>
                        }
                    </div>

                    <div class="form-group">
                        <label>Apellido</label>

                        <div class="input-wrapper @(_surnameInvalid ? "input-invalid" : "")">
                            <span class="input-icon">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 21a8 8 0 0 0-16 0" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </span>

                            <input type="text"
                                   placeholder="Apellido"
                                   @bind="_surname"
                                   @bind:event="oninput" />
                        </div>

                        @if (_surnameInvalid)
                        {
                            <span class="field-error">El apellido es obligatorio</span>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label>Email</label>

                    <div class="input-wrapper @(_emailInvalid ? "input-invalid" : "")">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 21a8 8 0 0 0-16 0" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>

                        <input type="email"
                               placeholder="Ingresa tu email"
                               @bind="_email"
                               @bind:event="oninput" />
                    </div>

                    @if (_emailInvalid)
                    {
                        <span class="field-error">El email es obligatorio</span>
                    }
                </div>

                <div class="form-group">
                    <label>Fecha de nacimiento</label>

                    <div class="input-wrapper @(_dateInvalid ? "input-invalid" : "")">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="3" y="4" width="18" height="17" rx="2" />
                                <path d="M16 2v4" />
                                <path d="M8 2v4" />
                                <path d="M3 10h18" />
                            </svg>
                        </span>

                        <input type="date"
                               @bind="_dateOfBirth" />
                    </div>

                    @if (_dateInvalid)
                    {
                        <span class="field-error">La fecha de nacimiento es obligatoria</span>
                    }
                </div>

                <div class="form-group">
                    <label>Contraseña</label>

                    <div class="input-wrapper @(_passwordInvalid ? "input-invalid" : "")">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                        </span>

                        <input type="@(_showPassword ? "text" : "password")"
                               placeholder="Ingresa tu contraseña"
                               @bind="_password"
                               @bind:event="oninput" />

                        <button type="button"
                                class="eye-button"
                                @onclick="TogglePasswordVisibility">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>

                    @if (_passwordInvalid)
                    {
                        <span class="field-error">La contraseña es obligatoria</span>
                    }
                </div>

                <div class="form-group">
                    <label>Confirmar contraseña</label>

                    <div class="input-wrapper @(_confirmPasswordInvalid ? "input-invalid" : "")">
                        <span class="input-icon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                        </span>

                        <input type="password"
                               placeholder="Repite la contraseña"
                               @bind="_confirmPassword"
                               @bind:event="oninput" />
                    </div>

                    @if (_confirmPasswordInvalid)
                    {
                        <span class="field-error">Las contraseñas no coinciden</span>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert-message alert-error">
                    @_errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert-message alert-success">
                    ✓ @_successMessage
                </div>
            }

            <button type="button" class="primary-button" @onclick="Submit">
                @(_showRegister ? "Crear cuenta" : "Iniciar sesión")
            </button>

            <div class="divider">
                <span></span>
                <p>o</p>
                <span></span>
            </div>

            <div class="switch-mode">
                <span>
                    @(_showRegister ? "¿Ya tienes una cuenta?" : "¿No tienes cuenta?")
                </span>

                <button type="button" @onclick="ToggleMode">
                    @(_showRegister ? "Inicia sesión" : "Regístrate")
                </button>
            </div>

        </div>

    </section>

</div>

<style>
    .login-page {
        min-height: calc(100vh - 120px);
        width: 100%;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background:
            radial-gradient(circle at top center, rgba(36, 88, 245, 0.08), transparent 34%),
            linear-gradient(180deg, #ffffff 0%, #fbfcff 55%, #f8fafc 100%);
        border-radius: 18px;
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .decorative-ball {
        position: absolute;
        right: -210px;
        bottom: -210px;
        width: 560px;
        height: 560px;
        border-radius: 50%;
        border: 14px solid #2458f5;
        opacity: 0.045;
        background:
            linear-gradient(60deg, transparent 44%, #2458f5 45%, #2458f5 47%, transparent 48%),
            linear-gradient(-60deg, transparent 44%, #2458f5 45%, #2458f5 47%, transparent 48%),
            linear-gradient(0deg, transparent 44%, #2458f5 45%, #2458f5 47%, transparent 48%);
        pointer-events: none;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
        position: relative;
        z-index: 2;
    }

    .login-header {
        text-align: center;
        margin-bottom: 1.8rem;
    }

    .trophy-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 1.1rem;
        color: #2458f5;
    }

    .trophy-icon svg {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .login-header h1 {
        margin: 0;
        font-size: 2rem;
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: #111827;
    }

    .login-header h1 span {
        color: #2458f5;
    }

    .login-header p {
        margin: 0.55rem 0 0;
        color: #667085;
        font-size: 1rem;
        font-weight: 500;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.45rem;
        box-shadow:
            0 24px 60px rgba(15, 23, 42, 0.08),
            0 8px 22px rgba(15, 23, 42, 0.04);
        backdrop-filter: blur(12px);
    }

    .form-group {
        margin-bottom: 1.1rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.45rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: #111827;
    }

    .register-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.85rem;
    }

    .input-wrapper {
        min-height: 48px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        display: flex;
        align-items: center;
        padding: 0 0.85rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .input-wrapper:focus-within {
        border-color: #2458f5;
        box-shadow: 0 0 0 4px rgba(36, 88, 245, 0.10);
    }

    .input-wrapper.input-invalid {
        border-color: #dc2626;
        box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.08);
    }

    .input-icon {
        width: 21px;
        height: 21px;
        margin-right: 0.85rem;
        color: #64748b;
        flex: 0 0 auto;
    }

    .input-icon svg,
    .eye-button svg {
        width: 100%;
        height: 100%;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .input-wrapper input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #111827;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .input-wrapper input::placeholder {
        color: #8a95a8;
    }

    .eye-button {
        width: 24px;
        height: 24px;
        border: 0;
        background: transparent;
        color: #64748b;
        padding: 0;
        margin-left: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .field-error {
        display: block;
        margin-top: 0.4rem;
        color: #dc2626;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .alert-message {
        margin: 0.4rem 0 1rem;
        padding: 0.75rem 0.9rem;
        border-radius: 8px;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .alert-error {
        color: #991b1b;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .alert-success {
        color: #166534;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .primary-button {
        width: 100%;
        min-height: 48px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(135deg, #2458f5, #1746d8);
        color: #ffffff;
        font-weight: 800;
        font-size: 0.95rem;
        cursor: pointer;
        box-shadow: 0 12px 24px rgba(36, 88, 245, 0.25);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .primary-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(36, 88, 245, 0.32);
    }

    .divider {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1rem;
        align-items: center;
        margin: 1.25rem 0;
    }

    .divider span {
        height: 1px;
        background: #e5e7eb;
    }

    .divider p {
        margin: 0;
        color: #667085;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .switch-mode {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.45rem;
        color: #475467;
        font-size: 0.95rem;
    }

    .switch-mode button {
        border: 0;
        background: transparent;
        color: #2458f5;
        font-weight: 800;
        cursor: pointer;
        padding: 0;
    }

    .switch-mode button:hover {
        text-decoration: underline;
    }

    @@media (max-width: 640px) {
        .login-page {
            min-height: calc(100vh - 90px);
            align-items: flex-start;
            padding: 2.5rem 1rem;
        }

        .login-header h1 {
            font-size: 1.65rem;
        }

        .login-card {
            padding: 1.15rem;
        }

        .register-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .decorative-ball {
            width: 360px;
            height: 360px;
            right: -170px;
            bottom: -160px;
        }
    }
</style>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _name = string.Empty;
    private string _surname = string.Empty;
    private DateTime _dateOfBirth = DateTime.Today.AddYears(-18);

    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    private bool _showRegister;
    private bool _showPassword;

    private bool _emailInvalid;
    private bool _passwordInvalid;
    private bool _confirmPasswordInvalid;
    private bool _nameInvalid;
    private bool _surnameInvalid;
    private bool _dateInvalid;

    protected override void OnInitialized()
    {
        if (SessionService.IsLoggedIn())
        {
            Navigation.NavigateTo("/");
        }
    }

    private Task Submit()
    {
        return _showRegister ? DoRegister() : DoLogin();
    }

    private Task DoLogin()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (!ValidateLoginForm())
        {
            return Task.CompletedTask;
        }

        try
        {
            SessionService.Login(_email, _password);
            Navigation.NavigateTo("/");
        }
        catch (ArgumentException)
        {
            _errorMessage = "Email o contraseña inválidos.";
        }

        return Task.CompletedTask;
    }

    private async Task DoRegister()
    {
        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        if (!ValidateRegisterForm())
        {
            return;
        }

        try
        {
            var request = new UserRequest
            {
                Name = _name,
                Surname = _surname,
                Email = _email,
                DateOfBirth = _dateOfBirth,
                Password = _password
            };

            UserService.AddUser(request);

            _successMessage = "Cuenta creada correctamente. Redirigiendo...";
            StateHasChanged();

            await Task.Delay(1200);

            SessionService.Login(_email, _password);
            Navigation.NavigateTo("/");
        }
        catch (ArgumentException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ToggleMode()
    {
        _showRegister = !_showRegister;
        ClearForm();
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private bool ValidateLoginForm()
    {
        _emailInvalid = string.IsNullOrWhiteSpace(_email);
        _passwordInvalid = string.IsNullOrWhiteSpace(_password);

        return !_emailInvalid && !_passwordInvalid;
    }

    private bool ValidateRegisterForm()
    {
        _nameInvalid = string.IsNullOrWhiteSpace(_name);
        _surnameInvalid = string.IsNullOrWhiteSpace(_surname);
        _emailInvalid = string.IsNullOrWhiteSpace(_email);
        _dateInvalid = _dateOfBirth == DateTime.MinValue;
        _passwordInvalid = string.IsNullOrWhiteSpace(_password);
        _confirmPasswordInvalid =
            string.IsNullOrWhiteSpace(_confirmPassword) ||
            _password != _confirmPassword;

        return !_nameInvalid
            && !_surnameInvalid
            && !_emailInvalid
            && !_dateInvalid
            && !_passwordInvalid
            && !_confirmPasswordInvalid;
    }

    private void ClearForm()
    {
        _email = string.Empty;
        _password = string.Empty;
        _confirmPassword = string.Empty;
        _name = string.Empty;
        _surname = string.Empty;
        _dateOfBirth = DateTime.Today.AddYears(-18);

        _errorMessage = string.Empty;
        _successMessage = string.Empty;

        _emailInvalid = false;
        _passwordInvalid = false;
        _confirmPasswordInvalid = false;
        _nameInvalid = false;
        _surnameInvalid = false;
        _dateInvalid = false;

        _showPassword = false;
    }
}