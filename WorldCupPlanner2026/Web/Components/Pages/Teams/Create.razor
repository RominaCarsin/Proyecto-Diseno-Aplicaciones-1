@page "/teams/create"
@rendermode InteractiveServer
@using DTOs
@using IServices
@inject ITeamService TeamService
@inject ISessionService SessionService

<div class="container-fluid p-0 space-y-6">
    @if (!IsAdmin)
    {
        <div class="bg-white border-custom p-4 diagonal-corners text-muted">
            No tienes permisos para gestionar equipos.
        </div>
    }
    else
    {
        <div class="bg-white border-custom p-4 diagonal-corners">
            <h3 class="mb-3">@(editingTeamName == null ? "Crear Equipo" : "Editar Equipo")</h3>
            <hr class="geometric-divider" />

            <div class="row g-3 mb-4 mt-2">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Nombre</label>
                    <input type="text" @bind="formData.Name" maxlength="60" placeholder="Nombre del equipo"
                           class="form-control border-custom-input" />
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Confederacion</label>
                    <select @bind="formData.ConfederationName" class="form-select border-custom-input">
                        <option value="" disabled selected>Seleccione una confederacion</option>
                        @foreach (var conf in confederations)
                        {
                            <option value="@conf.Name" disabled="@(conf.RemainingSlots <= 0 && formData.ConfederationName != conf.Name)">
                                @conf.Name (@conf.RemainingSlots cupos disponibles)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Ranking FIFA</label>
                    <input type="number" @bind="formData.RankingFifa" min="300" max="2500"
                           class="form-control border-custom-input" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success border-custom py-2">@successMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger border-custom py-2">@errorMessage</div>
            }

            <div class="d-flex gap-2">
                @if (editingTeamName != null)
                {
                    <button @onclick="UpdateTeam" class="btn btn-wc-blue px-4">Actualizar</button>
                    <button @onclick="CancelEdit" class="btn btn-outline-dark border-custom px-4">Cancelar</button>
                }
                else
                {
                    <button @onclick="CreateTeam" class="btn btn-wc-red px-4 d-flex align-items-center gap-2">
                        <i class="bi bi-plus-lg"></i> Crear
                    </button>
                }
            </div>
        </div>

        <div class="bg-white border-custom p-4 diagonal-corners">
            <h3 class="mb-3">Simular / Completar Equipos</h3>
            <hr class="geometric-divider" />

            <div class="row align-items-end g-3 mt-2">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Semilla (opcional)</label>
                    <input type="text" @bind="simulationSeed" @bind:event="oninput" placeholder="Semilla para simulacion"
                           class="form-control border-custom-input" />
                </div>
                <div class="col-md-4">
                    <button @onclick="SimulateTeams"
                            class="btn btn-wc-green w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shuffle"></i> Autocompletar hasta 48
                    </button>
                </div>
                <div class="col-md-2">
                    <div class="status-counter text-center p-2 border-custom bg-light fw-bold">
                        @teams.Count() / 48
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white border-custom diagonal-corners overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light border-bottom-2">
                        <tr>
                            <th class="px-4 py-3">Nombre</th>
                            <th class="px-4 py-3">Confederacion</th>
                            <th class="px-4 py-3">Ranking</th>
                            <th class="px-4 py-3 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!teams.Any())
                        {
                            <tr>
                                <td colspan="4" class="px-4 py-4 text-center text-muted">
                                    No hay equipos registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var team in teams)
                            {
                                <tr>
                                    <td class="px-4 py-3 align-middle fw-medium">@team.Name</td>
                                    <td class="px-4 py-3 align-middle">
                                        <span class="badge-conf @GetConfColor(team.ConfederationName)">
                                            @team.ConfederationName
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 align-middle">@team.RankingFifa</td>
                                    <td class="px-4 py-3 align-middle">
                                        <div class="d-flex justify-content-center gap-2">
                                            <button @onclick="() => EditTeam(team)"
                                                    disabled="@(editingTeamName == team.Name)"
                                                    class="btn btn-sm btn-light border-custom">
                                                <i class="bi bi-pencil"></i> Actualizar
                                            </button>
                                            <button @onclick="() => DeleteTeam(team.Name)"
                                                    disabled="@(editingTeamName == team.Name)"
                                                    class="btn btn-sm btn-outline-danger border-custom">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<TeamResponse> teams = Enumerable.Empty<TeamResponse>();
    private IEnumerable<ConfederationResponse> confederations = Enumerable.Empty<ConfederationResponse>();
    private TeamRequest formData = NewTeamRequest();
    private string? editingTeamName;
    private string simulationSeed = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool IsAdmin => SessionService.IsLoggedIn() && SessionService.CurrentUserHasRole(RoleDto.Admin);

    protected override void OnInitialized()
    {
        if (IsAdmin)
        {
            RefreshUI();
        }
    }

    private void CreateTeam() => SaveTeam();

    private void EditTeam(TeamResponse team)
    {
        editingTeamName = team.Name;
        formData = new TeamRequest
        {
            Name = team.Name,
            ConfederationName = team.ConfederationName,
            RankingFifa = team.RankingFifa
        };
        ClearMessages();
    }

    private void UpdateTeam() => SaveTeam();

    private void CancelEdit()
    {
        editingTeamName = null;
        formData = NewTeamRequest();
        ClearMessages();
    }

    private void DeleteTeam(string name)
    {
        ClearMessages();
        try
        {
            TeamService.DeleteTeam(name);
            RefreshUI();
            successMessage = $"Equipo '{name}' eliminado.";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void SimulateTeams()
    {
        ClearMessages();

        try
        {
            var parsedSeed = int.TryParse(simulationSeed, out var seed) ? seed : 0;

            TeamService.AutoCompleteTeams(parsedSeed);
            RefreshUI();
            successMessage = "Equipos autocompletados correctamente.";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void SaveTeam()
    {
        ClearMessages();
        try
        {
            if (editingTeamName == null)
            {
                TeamService.AddTeam(formData);
                successMessage = $"Equipo '{formData.Name}' creado.";
            }
            else
            {
                TeamService.UpdateTeam(editingTeamName, formData);
                successMessage = $"Equipo '{formData.Name}' actualizado.";
            }

            editingTeamName = null;
            formData = NewTeamRequest();
            RefreshUI();
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

     private void RefreshUI()
     {
         var seed = int.TryParse(simulationSeed, out var parsed) ? parsed : 0;

         teams = TeamService.GetTeamsOrdered(seed);
         confederations = TeamService.GetConfederations();
     }

    private void ClearMessages()
    {
        errorMessage = "";
        successMessage = "";
    }

    private string GetConfColor(string conf) => conf switch
    {
        "AFC" => "conf-afc",
        "CAF" => "conf-caf",
        "CONCACAF" => "conf-concacaf",
        "CONMEBOL" => "conf-conmebol",
        "OFC" => "conf-ofc",
        "UEFA" => "conf-uefa",
        _ => "bg-light"
    };

    private static TeamRequest NewTeamRequest() => new()
    {
        ConfederationName = "",
        RankingFifa = 300
    };
}
